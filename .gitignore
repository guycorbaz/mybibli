# Rust
/target/
**/*.rs.bk
# Cargo.lock is COMMITTED — mybibli ships as a binary application (not a
# library), so a frozen lockfile gives reproducible builds across the
# Dockerfile, the release workflow, and `git checkout vX.Y.Z` checkouts.
# See ROADMAP.md / v1.6.2 notes for the rationale.

# Node.js (Playwright tests)
node_modules/
package-lock.json
!tests/e2e/package-lock.json

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Environment and secrets
.env
.env.*
!.env.example

# Docker
docker-compose.override.yml

# Cover images (stored in Docker volume, not in repo)
/data/covers/

# Claude Code (local settings + auto-memory, not shared)
.claude/settings.local.json
.claude/settings.json
.claude/projects/

# Playwright test artifacts
/test-results/
tests/e2e/test-results/
tests/e2e/playwright-report/

# Generated CSS (built in CI/Docker)
static/css/output.css

# Build artifacts
*.log

# Tailwind build (root level, not tests/)
/package.json
.claude/scheduled_tasks.lock

# Marketing — drafts, ideas, channel notes, outreach trackers.
# Intentionally local-only per memory [[feedback-marketing-drafts-stay-local]];
# any published material lands on the project's public surfaces (README,
# website, manual) via a regular PR, not from inside this directory.
/marketing/
